# Copy to .env.local and fill in. Never commit real values.

# Public site URL. Production uses it for Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=https://www.youngmindset.org

# Comma-separated origins allowed to call the form APIs. Defaults to the request's own origin.
SECURITY_ALLOWED_ORIGINS=https://www.youngmindset.org,https://youngmindset.org

# Stripe: use a restricted key (see README). Use test-mode keys outside production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend: API key with "Full access" (contacts need it) and the newsletter segment ID.
RESEND_API_KEY=
RESEND_NEWSLETTER_SEGMENT_ID=
